{
  "name": "@a0n/maybe",
  "sourceRoot": "open-source/maybe/src",
  "projectType": "library",
  "tags": [
    "npm:public"
  ],
  "targets": {
    "typecheck:journeys": {
      "executor": "a0:run-commands",
      "cache": false,
      "options": {
        "cwd": "open-source/maybe",
        "command": "../gnosis/bin/monster x tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck --types node src/journey-selection.ts",
        "monster": {
          "nodeLeaf": {
            "reason": "Check finite journey utility selection and its browser-safe probability dependency.",
            "args": [
              "../../open-source/gnosis/bin/gnode.js",
              "x",
              "tsc",
              "--noEmit",
              "--strict",
              "--target",
              "ES2022",
              "--module",
              "ESNext",
              "--moduleResolution",
              "bundler",
              "--skipLibCheck",
              "--types",
              "node",
              "src/journey-selection.ts"
            ]
          }
        }
      }
    },
    "test:journeys": {
      "executor": "a0:run-commands",
      "cache": false,
      "options": {
        "cwd": "open-source/maybe",
        "command": "../gnosis/bin/monster test src/journey-selection.test.ts",
        "monster": {
          "nodeLeaf": {
            "reason": "Verify finite observed-prefix probability, resource budgets, shared-prefix utility and evidence boundaries.",
            "args": [
              "../gnosis/bin/gnode.js",
              "test",
              "src/journey-selection.test.ts"
            ]
          }
        }
      }
    },
    "typecheck": {
      "executor": "a0:run-commands",
      "dependsOn": [
        "^typecheck"
      ],
      "options": {
        "cwd": "open-source/maybe",
        "command": "../gnosis/bin/monster x tsc --noEmit -p tsconfig.json",
        "monster": {
          "nodeLeaf": {
            "reason": "Typecheck the whole Maybe package against its tsconfig.",
            "args": [
              "../../open-source/gnosis/bin/gnode.js",
              "x",
              "tsc",
              "--noEmit",
              "-p",
              "tsconfig.json"
            ]
          }
        }
      }
    },
    "test": {
      "executor": "a0:run-commands",
      "options": {
        "cwd": "open-source/maybe",
        "command": "../gnosis/bin/monster test src",
        "monster": {
          "nodeLeaf": {
            "reason": "Run every Maybe package test through the repo-owned Gnosis test runner.",
            "args": [
              "../gnosis/bin/gnode.js",
              "test",
              "src"
            ]
          }
        }
      }
    },
    "build": {
      "executor": "a0:run-commands",
      "options": {
        "cwd": "open-source/maybe",
        "command": "echo source-only topology: checked-in package surface"
      },
      "metadata": {
        "topologyKind": "source-only"
      }
    },
    "test:memory": {
      "executor": "a0:run-commands",
      "cache": false,
      "options": {
        "cwd": "open-source/maybe",
        "command": "../gnosis/bin/monster test src/memory-abduction.test.ts",
        "monster": {
          "nodeLeaf": {
            "reason": "Verify the bounded memory adapter against the actual Maybe abductive engine.",
            "args": [
              "../gnosis/bin/gnode.js",
              "test",
              "src/memory-abduction.test.ts"
            ]
          }
        }
      }
    },
    "typecheck:memory": {
      "executor": "a0:run-commands",
      "cache": false,
      "options": {
        "cwd": "open-source/maybe",
        "command": "../gnosis/bin/monster x tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck --types node src/memory-abduction.ts",
        "monster": {
          "nodeLeaf": {
            "reason": "Verify the bounded memory adapter against the actual Maybe abductive engine.",
            "args": [
              "../../open-source/gnosis/bin/gnode.js",
              "x",
              "tsc",
              "--noEmit",
              "--strict",
              "--target",
              "ES2022",
              "--module",
              "ESNext",
              "--moduleResolution",
              "bundler",
              "--skipLibCheck",
              "--types",
              "node",
              "src/memory-abduction.ts"
            ]
          }
        }
      }
    }
  }
}

// complement.gg -- Core Buleyean complement distribution
//
// P(i) = (T - v_i + 1) / sum_j(T - v_j + 1)
//
// Unlike gnosis softmax complement (exp(-eta * v)), Buleyean uses exact
// linear weights. No temperature parameter. Provably positive, normalized,
// and monotone.

// ── Inputs ──────────────────────────────────────────────────────────

(void_boundary:Parameter { value: "[]", description: "per-dimension rejection counts" })
(total_entries:Parameter { value: "0", description: "T = total entries in void" })

// ── Core Formula ────────────────────────────────────────────────────

(weights:Logic { op: "buleyean_weights", formula: "T - v_i + 1" })
(normalize:Logic { op: "normalize_sum", description: "divide by sum to get probabilities" })

(void_boundary)-[:PROCESS]->(weights)
(total_entries)-[:PROCESS]->(weights)
(weights)-[:PROCESS]->(normalize)

// ── Output ──────────────────────────────────────────────────────────

(distribution:Result { kind: "ok", description: "Buleyean probability distribution" })
(normalize)-[:PROCESS]->(distribution)

// ── Axiom Verification (self-check) ─────────────────────────────────

(check_positive:Logic { op: "assert_all_positive", invariant: "positivity" })
(check_sum:Logic { op: "assert_sum_one", invariant: "normalization" })
(check_mono:Logic { op: "assert_monotone", invariant: "monotonicity" })

(distribution)-[:FORK]->(check_positive | check_sum | check_mono)
(check_positive | check_sum | check_mono)-[:FOLD { strategy: "all-pass" }]->(axioms_hold:Result)

@topology bule-altimeter
@description "The Bule number: altimeter of convergence"
@version "1.0.0"

# Two numbers describe any system under irreversible process:
#   Buleyean distribution = compass: what to try next
#   Bule number = altimeter: how far from convergence

node compute_bule {
  type: FOLD
  description: "B = max_v - min_v: integer distance from ground state"
}

node compute_distribution {
  type: FOLD
  description: "P_i = T - v_i + 1 over sum: the compass"
}

node beta1_state {
  type: FORK
  description: "Fork into natural parallelism vs actual parallelism"
  beta1_delta: +1
}

node deficit_measure {
  type: FOLD
  description: "Delta_beta = beta1_natural - beta1_actual"
  beta1_delta: -1
}

# The sliver derivation chain
node vent_produces_heat {
  type: VENT
  description: "Every vent produces exactly 1 unit of Landauer heat"
}

node heat_is_sliver {
  type: FOLD
  description: "That 1 unit maps to the +1 in w_i = T - v_i + 1"
}

node positivity_follows {
  type: FOLD
  description: "w_i >= 1 > 0 for all i: positivity is thermodynamic"
}

edge vent_produces_heat -> heat_is_sliver { type: FOLD }
edge heat_is_sliver -> positivity_follows { type: FOLD }

# Statistical teleportation
node teleport {
  type: FOLD
  description: "deficit at T plus k = max of zero and B minus k: one integer encodes the future"
}

# Void boundary merging: CRDT
node merge_boundaries {
  type: FOLD
  description: "w_merge_i = w_A_i + w_B_i - 1: two slivers become one"
}

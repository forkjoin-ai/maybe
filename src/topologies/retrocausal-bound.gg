// retrocausal-bound.gg -- Terminal state constrains trajectory
//
// The retrocausal layer encodes terminal states (what must be avoided)
// and propagates their void backward through the adjacency structure.
// Maps to BoundaryStack layer 0 (deepest, timescale: lifetime).
//
// Theorem: terminal_void(s) > 0 => ancestor_void(s, t) > 0 for all t < T

// ── Inputs ──────────────────────────────────────────────────────────

(terminal_states:Input { value: "[]", description: "absorbing boundaries to avoid" })
(adjacency:Input { value: "[]", description: "graph structure for backward propagation" })
(void_boundary:Input { value: "[]" })

// ── Terminal Encoding ───────────────────────────────────────────────

(encode:Logic { op: "encode_terminal_states", description: "massive initial void for terminal dimensions" })

(terminal_states)-[:PROCESS { role: "adjacency-source" }]->(adjacency)
(adjacency)-[:PROCESS]->(encode)
(encode)-[:PROCESS]->(void_boundary)

// ── Backward Propagation ────────────────────────────────────────────

(propagate:Logic { op: "propagate_backward", factor: "0.5", maxHops: "3" })

(void_boundary)-[:PROCESS]->(propagate)
(propagate)-[:PROCESS { convergence: "bounded-propagation" }]->(verify)

// ── Bound Verification ──────────────────────────────────────────────

(verify:Logic { op: "verify_retrocausal_bound" })


// ── Output ──────────────────────────────────────────────────────────

(verify)-[:PROCESS { condition: "bound-holds" }]->(bound_holds)
(bound_holds)-[:PROCESS { condition: "bound-violated-reviewed" }]->(bound_violated)
(bound_holds:Result { kind: "ok", description: "retrocausal bound satisfied" })
(bound_violated:Result { kind: "err", description: "retrocausal bound violated -- terminal state reachable" })
(bound_violated)-[:PROCESS { reason: "bound-admission" }]->(buleyean_dist:Logic { op: "buleyean_distribution" })

(buleyean_dist)-[:PROCESS]->(constrained:Result { kind: "ok", description: "retrocausally constrained distribution" })
(constrained)-[:MEASURE { reason: "retrocausal-bound-audit" }]->(constrained_trace:Trace)
